      "buttons": []
    },
    {
      "id": "C-02",
      "text": "급한 일은 대개 안 급하다. 급한 척할 뿐이다.",
      "screen": "daily_card",
      "role": "observe",
      "intensity": "low",
      "origin": "creative",
      "rootId": null,
